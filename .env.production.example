# ============================================
# .env.production.example — ชื่อคีย์เท่านั้น ไม่มีค่าจริงสักบรรทัด
# ไฟล์จริง (.env.production) อยู่บน production host เท่านั้น (/opt/posternung/.env.production)
# ห้าม scp/cat/แสดงค่าในไฟล์นั้นออกมา (docker-environments §production)
# ไฟล์นี้ commit เข้า git ได้ (ไม่มี secret จริง) — !.env.production.example ใน .gitignore
# ============================================

# ---- Environment (required) — ต้องเป็น production เป๊ะ ----
ENVIRONMENT=production

# ---- App — production บังคับสองค่านี้ (config validator raise ตอน boot ถ้าไม่ใช่) ----
DEBUG=false
DOCS_ENABLED=false

# ---- PostgreSQL (ใช้โดย docker-compose.yml) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ---- Database connection string (ใช้โดย FastAPI / SQLAlchemy) ----
DATABASE_URL=

# ---- JWT / Auth ----
JWT_SECRET=
JWT_ALGORITHM=
JWT_ACCESS_EXPIRE_MINUTES=
JWT_REFRESH_EXPIRE_DAYS=

# ---- Reservation TTL (F3) ----
RESERVE_TTL_MINUTES=

# ---- Media base URL (ADR-0006) ----
MEDIA_BASE_URL=

# ---- Firebase / Social login ----
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-sa.json
FIREBASE_SA_HOST_PATH=

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=

# ---- Container image (CI ตั้งเป็น git sha ตอน deploy) ----
IMAGE_REGISTRY=
IMAGE_TAG=

# ---- ADR-0015 Amendment 3 (INF-44) — เส้นเขียน production สำหรับเจ้าของ ----
# path สัมบูรณ์บน production host (ไม่ใช่ path ในคอนเทนเนอร์) — bind-mount โดย
# docker-compose.production.yml ผ่าน ${VAR:?...} ทุกตัว (ห้าม relative — source ถูก
# resolve บน host ปลายทาง ไม่ใช่บนเครื่องที่รัน docker compose)
# checkout ที่ deploy.sh sync ให้ sha ตรงกับ image ทุกครั้งก่อน compose up — path นี้
# ต้องอยู่ใต้ checkout เดียวกัน (deploy.sh derive checkout dir จาก dirname ของค่านี้)
SCRIPTS_HOST_PATH=
# path ของไฟล์ .env.production เอง (เพื่อ mount เข้า container ให้ scripts/seed/*.py
# ยืนยัน --target production ด้วยการเทียบไฟล์จริงได้ — เหมือน .env.sit บน sit)
ENV_FILE_HOST_PATH=
# โฟลเดอร์แม่ของ audit ถาวร (⑥) + backup-ref (⑦) — ต้องมี audit/ backups/ totp/
# เป็น subdirectory อยู่แล้วก่อน compose up (mode 750 เจ้าของ deploy:deploy)
OPS_HOST_DIR=
# path ของไฟล์ secret TOTP (mode 0400) — enroll ครั้งเดียวด้วย scripts/ops_totp.py
OPS_TOTP_SECRET_PATH=

# ---- Payment provider — Phase 2 (ADR-0029 เลื่อน Omise ไป Phase 2) ----
# MVP รับเงินด้วยโอนเข้าบัญชีกลาง + อัปสลิป + แอดมินยืนยัน ไม่ใช่ Omise/Stripe
# STRIPE_SECRET_KEY=
# OMISE_SECRET_KEY=
